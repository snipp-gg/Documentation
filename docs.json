{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "appearance": {
    "default": "dark",
    "isHidden": false,
    "strict": false
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#0a0a0a"
    }
  },
  "name": "Snipp",
  "description": "Snipp is the modern way to share your uploads with the world.",
  "colors": {
    "primary": "#171717",
    "light": "#404040",
    "dark": "#ffffff"
  },
  "favicon": "https://cdn.snipp.gg/favicon.ico",
  "seo": {
    "metatags": {
      "twitter:card": "summary_large_image",
      "og:image": "https://cdn.snipp.gg/banner.png",
      "twitter:image": "https://cdn.snipp.gg/banner.png"
    }
  },
  "api": {
    "baseUrl": "https://api.snipp.gg",
    "auth": {
      "method": "key",
      "name": "api-key",
      "inputPrefix": "api-key"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart",
              "authentication",
              "migration"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/file-types",
              "concepts/errors",
              "concepts/pagination",
              "concepts/rate-limits",
              "concepts/custom-domains",
              "concepts/plans"
            ]
          }
        ]
      },
      {
        "tab": "SDKs",
        "groups": [
          {
            "group": "SDKs",
            "pages": [
              "sdks/introduction",
              "sdks/node",
              "sdks/python",
              "sdks/rust"
            ]
          }
        ]
      },
      {
        "tab": "Discord Bot",
